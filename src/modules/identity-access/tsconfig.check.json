{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist-check",
    "types": []
  },
  "include": [
    "index.ts",
    "manifest.ts",
    "module-doc.ts",
    "adapters/**/*.ts",
    "vendor/core/**/*.ts",
    "vendor/adapters/**/*.ts"
  ]
}
